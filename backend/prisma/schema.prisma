generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ESTADOS
model Estado {
  idEstado  Int      @id @default(autoincrement()) @map("id_estado")
  nombre    String   @unique @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  usuarios Usuario[]

  @@map("estados")
}

// TIPOS DE DOCUMENTO
model TipoDocumento {
  idTipoDocumento Int      @id @default(autoincrement()) @map("id_tipo_documento")
  nombre          String   @unique @db.VarChar(255)
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  usuariosPerfiles   UsuarioPerfil[]
  sucursalesPerfiles SucursalPerfil[]

  @@map("tipos_documento")
}

// USUARIOS
model Usuario {
  idUsuario  Int    @id @default(autoincrement()) @map("id_usuario")
  correo     String @unique @db.VarChar(255)
  contrasena String @db.VarChar(255)

  idEstado Int    @map("id_estado")
  estado   Estado @relation(fields: [idEstado], references: [idEstado], onDelete: Restrict)

  idRol Int @map("id_rol")
  rol   Rol @relation(fields: [idRol], references: [idRol], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  perfil     UsuarioPerfil?
  sucursales UsuarioSucursal[]

  @@map("usuarios")
}

// PERFIL DE USUARIO
model UsuarioPerfil {
  idUsuario Int @id @map("id_usuario")

  nombres         String         @db.VarChar(255)
  apellidos       String         @db.VarChar(255)
  idTipoDocumento Int?           @map("id_tipo_documento")
  tipoDocumento   TipoDocumento? @relation(fields: [idTipoDocumento], references: [idTipoDocumento], onDelete: Restrict)
  numeroDocumento String?        @map("numero_documento") @db.VarChar(20)
  telefono        String?        @db.VarChar(20)
  direccion       String?        @db.VarChar(255)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  usuario Usuario @relation(fields: [idUsuario], references: [idUsuario], onDelete: Cascade)

  @@unique([idTipoDocumento, numeroDocumento])
  @@map("usuarios_perfiles")
}

// ROLES
model Rol {
  idRol     Int      @id @default(autoincrement()) @map("id_rol")
  nombre    String   @unique @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  usuarios Usuario[]
  permisos RolPermiso[]

  @@map("roles")
}

// PERMISOS
model Permiso {
  idPermiso Int    @id @default(autoincrement()) @map("id_permiso")
  nombre    String @unique @db.VarChar(100)

  roles RolPermiso[]

  @@map("permisos")
}

// CATÁLOGO DE MEDIOS DE PAGO
model MedioPago {
  idMedioPago Int    @id @default(autoincrement()) @map("id_medio_pago")
  nombre      String @unique @db.VarChar(45)

  @@map("medios_pago")
}

// ROLES - PERMISOS
model RolPermiso {
  idRol     Int @map("id_rol")
  idPermiso Int @map("id_permiso")

  rol     Rol     @relation(fields: [idRol], references: [idRol], onDelete: Cascade)
  permiso Permiso @relation(fields: [idPermiso], references: [idPermiso], onDelete: Cascade)

  @@id([idRol, idPermiso])
  @@map("roles_permisos")
}

// SUCURSALES
model Sucursal {
  idSucursal Int      @id @default(autoincrement()) @map("id_sucursal")
  nombre     String   @db.VarChar(255)
  activo     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  perfil   SucursalPerfil?
  usuarios UsuarioSucursal[]

  @@map("sucursales")
}

// PERFIL DE SUCURSAL
model SucursalPerfil {
  idSucursal      Int            @id @map("id_sucursal")
  idTipoDocumento Int?           @map("id_tipo_documento")
  tipoDocumento   TipoDocumento? @relation(fields: [idTipoDocumento], references: [idTipoDocumento], onDelete: Restrict)
  numeroDocumento String?        @map("numero_documento") @db.VarChar(20)
  razonSocial     String?        @map("razon_social") @db.VarChar(255)
  nombreComercial String?        @map("nombre_comercial") @db.VarChar(255)

  departamento       String?  @db.VarChar(100)
  provincia          String?  @db.VarChar(100)
  distrito           String?  @db.VarChar(100)
  direccionComercial String?  @map("direccion_comercial") @db.VarChar(255)
  direccionFiscal    String?  @map("direccion_fiscal") @db.VarChar(255)
  direccionWeb       String?  @map("direccion_web") @db.VarChar(255)
  ubigeo             String?  @db.VarChar(6)
  igv                Decimal  @default(18.00) @db.Decimal(5, 2)
  telefono           String?  @db.VarChar(20)
  correo             String?  @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sucursal Sucursal @relation(fields: [idSucursal], references: [idSucursal], onDelete: Cascade)

  @@map("sucursales_perfiles")
}

// USUARIOS - SUCURSALES
model UsuarioSucursal {
  idUsuario  Int @map("id_usuario")
  idSucursal Int @map("id_sucursal")

  usuario  Usuario  @relation(fields: [idUsuario], references: [idUsuario], onDelete: Cascade)
  sucursal Sucursal @relation(fields: [idSucursal], references: [idSucursal], onDelete: Cascade)

  @@id([idUsuario, idSucursal])
  @@map("usuarios_sucursales")
}
