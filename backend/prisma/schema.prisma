generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ESTADOS
model Estado {
  idEstado  Int      @id @default(autoincrement()) @map("id_estado")
  nombre    String   @unique @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  usuarios Usuario[]

  @@map("estados")
}

// TIPOS DE DOCUMENTO
model TipoDocumento {
  idTipoDocumento Int      @id @default(autoincrement()) @map("id_tipo_documento")
  nombre          String   @unique @db.VarChar(255)
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  usuariosPerfiles   UsuarioPerfil[]
  sucursalesPerfiles SucursalPerfil[]
  clientes           Cliente[]
  proveedores        Proveedor[]

  @@map("tipos_documento")
}

// USUARIOS
model Usuario {
  idUsuario  Int    @id @default(autoincrement()) @map("id_usuario")
  correo     String @unique @db.VarChar(255)
  contrasena String @db.VarChar(255)

  idEstado Int    @map("id_estado")
  estado   Estado @relation(fields: [idEstado], references: [idEstado], onDelete: Restrict)

  idRol Int @map("id_rol")
  rol   Rol @relation(fields: [idRol], references: [idRol], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  perfil                UsuarioPerfil?
  sucursales            UsuarioSucursal[]
  movimientosInventario InventarioMovimiento[]
  cajasAbiertas         Caja[]                 @relation("CajaUsuarioApertura")
  cajasCerradas         Caja[]                 @relation("CajaUsuarioCierre")
  ingresos              Ingreso[]
  egresos               Egreso[]
  compras               Compra[]

  @@map("usuarios")
}

// PERFIL DE USUARIO
model UsuarioPerfil {
  idUsuario Int @id @map("id_usuario")

  nombres         String         @db.VarChar(255)
  apellidos       String         @db.VarChar(255)
  idTipoDocumento Int?           @map("id_tipo_documento")
  tipoDocumento   TipoDocumento? @relation(fields: [idTipoDocumento], references: [idTipoDocumento], onDelete: Restrict)
  numeroDocumento String?        @map("numero_documento") @db.VarChar(20)
  telefono        String?        @db.VarChar(20)
  direccion       String?        @db.VarChar(255)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  usuario Usuario @relation(fields: [idUsuario], references: [idUsuario], onDelete: Cascade)

  @@unique([idTipoDocumento, numeroDocumento])
  @@map("usuarios_perfiles")
}

// ROLES
model Rol {
  idRol     Int      @id @default(autoincrement()) @map("id_rol")
  nombre    String   @unique @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  usuarios Usuario[]
  permisos RolPermiso[]

  @@map("roles")
}

// PERMISOS
model Permiso {
  idPermiso Int    @id @default(autoincrement()) @map("id_permiso")
  nombre    String @unique @db.VarChar(100)

  roles RolPermiso[]

  @@map("permisos")
}

// CATÁLOGO DE MEDIOS DE PAGO
model MedioPago {
  idMedioPago Int    @id @default(autoincrement()) @map("id_medio_pago")
  nombre      String @unique @db.VarChar(45)

  detallesCaja  CajaDetalle[]
  pagosIngresos IngresoDetallePago[]
  pagosEgresos  EgresoDetallePago[]

  @@map("medios_pago")
}

// CAJA Y SALDOS POR MEDIO DE PAGO
model Caja {
  idCaja            Int       @id @default(autoincrement()) @map("id_caja")
  idSucursal        Int       @map("id_sucursal")
  idUsuarioApertura Int       @map("id_usuario_apertura")
  fechaApertura     DateTime  @default(now()) @map("fecha_apertura")
  montoApertura     Decimal   @map("monto_apertura") @db.Decimal(14, 2)
  idUsuarioCierre   Int?      @map("id_usuario_cierre")
  fechaCierre       DateTime? @map("fecha_cierre")
  montoCierre       Decimal?  @map("monto_cierre") @db.Decimal(14, 2)

  sucursal        Sucursal      @relation(fields: [idSucursal], references: [idSucursal], onDelete: Restrict)
  usuarioApertura Usuario       @relation("CajaUsuarioApertura", fields: [idUsuarioApertura], references: [idUsuario], onDelete: Restrict)
  usuarioCierre   Usuario?      @relation("CajaUsuarioCierre", fields: [idUsuarioCierre], references: [idUsuario], onDelete: Restrict)
  detalles        CajaDetalle[]
  ingresos        Ingreso[]
  egresos         Egreso[]

  @@unique([idCaja, idSucursal])
  @@index([idSucursal, fechaCierre])
  @@map("cajas")
}

model CajaDetalle {
  idCaja      Int     @map("id_caja")
  idMedioPago Int     @map("id_medio_pago")
  monto       Decimal @db.Decimal(14, 2)

  caja      Caja      @relation(fields: [idCaja], references: [idCaja], onDelete: Restrict)
  medioPago MedioPago @relation(fields: [idMedioPago], references: [idMedioPago], onDelete: Restrict)

  @@id([idCaja, idMedioPago])
  @@map("caja_detalle")
}

model MotivoIngreso {
  idMotivoIngreso Int     @id @default(autoincrement()) @map("id_motivo_ingreso")
  motivo          String  @unique @db.VarChar(100)
  activo          Boolean @default(true)

  ingresos Ingreso[]

  @@map("motivo_ingreso")
}

model MotivoEgreso {
  idMotivoEgreso Int     @id @default(autoincrement()) @map("id_motivo_egreso")
  motivo         String  @unique @db.VarChar(100)
  activo         Boolean @default(true)

  egresos Egreso[]

  @@map("motivo_egreso")
}

model Ingreso {
  claveOperacion  String?  @unique @db.VarChar(36) @map("clave_operacion")
  huellaOperacion String?  @db.VarChar(64) @map("huella_operacion")
  idIngreso       Int      @id @default(autoincrement()) @map("id_ingreso")
  idCaja          Int      @map("id_caja")
  idSucursal      Int      @map("id_sucursal")
  idMotivoIngreso Int      @map("id_motivo_ingreso")
  idUsuario       Int      @map("id_usuario")
  monto           Decimal  @db.Decimal(14, 2)
  detalle         String?  @db.VarChar(500)
  fechaIngreso    DateTime @default(now()) @map("fecha_ingreso")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  caja           Caja                 @relation(fields: [idCaja, idSucursal], references: [idCaja, idSucursal], onDelete: Restrict, onUpdate: Restrict)
  sucursal       Sucursal             @relation(fields: [idSucursal], references: [idSucursal], onDelete: Restrict)
  motivoIngreso  MotivoIngreso        @relation(fields: [idMotivoIngreso], references: [idMotivoIngreso], onDelete: Restrict)
  usuario        Usuario              @relation(fields: [idUsuario], references: [idUsuario], onDelete: Restrict)
  productos      IngresoProducto[]
  pagos          IngresoDetallePago[]
  deudaOriginada DeudaCliente?        @relation("IngresoOrigenDeuda")
  abonoDeuda     AbonoDeudaCliente?

  @@index([idCaja, fechaIngreso])
  @@map("ingresos")
}

model Egreso {
  idEgreso       Int      @id @default(autoincrement()) @map("id_egreso")
  idCaja         Int      @map("id_caja")
  idSucursal     Int      @map("id_sucursal")
  idMotivoEgreso Int      @map("id_motivo_egreso")
  idCompra       Int?     @map("id_compra")
  idUsuario      Int      @map("id_usuario")
  monto          Decimal  @db.Decimal(14, 2)
  detalle        String?  @db.VarChar(500)
  fechaEgreso    DateTime @default(now()) @map("fecha_egreso")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  caja         Caja                @relation(fields: [idCaja, idSucursal], references: [idCaja, idSucursal], onDelete: Restrict, onUpdate: Restrict)
  sucursal     Sucursal            @relation(fields: [idSucursal], references: [idSucursal], onDelete: Restrict)
  compra       Compra?             @relation(fields: [idCompra, idSucursal], references: [idCompra, idSucursal], onDelete: Restrict, onUpdate: Restrict)
  motivoEgreso MotivoEgreso        @relation(fields: [idMotivoEgreso], references: [idMotivoEgreso], onDelete: Restrict)
  usuario      Usuario             @relation(fields: [idUsuario], references: [idUsuario], onDelete: Restrict)
  pagos        EgresoDetallePago[]
  percepciones CompraPercepcion[]
  deudaCliente DeudaCliente?

  @@unique([idEgreso, idCompra])
  @@index([idCaja, fechaEgreso])
  @@map("egresos")
}

// Cada detalle guarda el monto recibido o entregado por un medio de pago real.
model IngresoDetallePago {
  idIngreso   Int     @map("id_ingreso")
  idMedioPago Int     @map("id_medio_pago")
  monto       Decimal @db.Decimal(14, 2)

  ingreso   Ingreso   @relation(fields: [idIngreso], references: [idIngreso], onDelete: Restrict)
  medioPago MedioPago @relation(fields: [idMedioPago], references: [idMedioPago], onDelete: Restrict)

  @@id([idIngreso, idMedioPago])
  @@map("ingresos_detalle_pago")
}

model EgresoDetallePago {
  idEgreso    Int     @map("id_egreso")
  idMedioPago Int     @map("id_medio_pago")
  monto       Decimal @db.Decimal(14, 2)

  egreso    Egreso    @relation(fields: [idEgreso], references: [idEgreso], onDelete: Restrict)
  medioPago MedioPago @relation(fields: [idMedioPago], references: [idMedioPago], onDelete: Restrict)

  @@id([idEgreso, idMedioPago])
  @@map("egresos_detalle_pago")
}

// ROLES - PERMISOS
model RolPermiso {
  idRol     Int @map("id_rol")
  idPermiso Int @map("id_permiso")

  rol     Rol     @relation(fields: [idRol], references: [idRol], onDelete: Cascade)
  permiso Permiso @relation(fields: [idPermiso], references: [idPermiso], onDelete: Cascade)

  @@id([idRol, idPermiso])
  @@map("roles_permisos")
}

// SUCURSALES
model Sucursal {
  idSucursal Int      @id @default(autoincrement()) @map("id_sucursal")
  nombre     String   @db.VarChar(255)
  activo     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  perfil    SucursalPerfil?
  usuarios  UsuarioSucursal[]
  productos ProductoSucursal[]
  almacenes Almacen[]
  cajas     Caja[]
  compras   Compra[]
  ingresos  Ingreso[]
  egresos   Egreso[]

  @@map("sucursales")
}

// CLIENTES
model Cliente {
  idCliente       Int      @id @default(autoincrement()) @map("id_cliente")
  nombre          String   @db.VarChar(255)
  idTipoDocumento Int      @map("id_tipo_documento")
  numeroDocumento String   @map("numero_documento") @db.VarChar(20)
  direccion       String?  @db.VarChar(255)
  ubigeo          String?  @db.VarChar(6)
  correo          String?  @db.VarChar(255)
  telefono        String?  @db.VarChar(20)
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tipoDocumento TipoDocumento  @relation(fields: [idTipoDocumento], references: [idTipoDocumento], onDelete: Restrict)
  deudas        DeudaCliente[]

  @@unique([idTipoDocumento, numeroDocumento])
  @@index([nombre])
  @@index([activo])
  @@map("clientes")
}

// PROVEEDORES COMPARTIDOS POR TODAS LAS SUCURSALES
model Proveedor {
  idProveedor                Int      @id @default(autoincrement()) @map("id_proveedor")
  nombre                     String   @db.VarChar(255)
  idTipoDocumento            Int      @map("id_tipo_documento")
  numeroDocumento            String   @map("numero_documento") @db.VarChar(20)
  direccion                  String?  @db.VarChar(255)
  ubigeo                     String?  @db.VarChar(6)
  correo                     String?  @db.VarChar(255)
  telefono                   String?  @db.VarChar(20)
  activo                     Boolean  @default(true)
  aplicaPercepcionPorDefecto Boolean  @default(false) @map("aplica_percepcion_por_defecto")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  tipoDocumento TipoDocumento @relation(fields: [idTipoDocumento], references: [idTipoDocumento], onDelete: Restrict)
  compras       Compra[]

  @@unique([idTipoDocumento, numeroDocumento])
  @@index([nombre])
  @@index([activo])
  @@map("proveedores")
}

// PERFIL DE SUCURSAL
model SucursalPerfil {
  idSucursal      Int            @id @map("id_sucursal")
  idTipoDocumento Int?           @map("id_tipo_documento")
  tipoDocumento   TipoDocumento? @relation(fields: [idTipoDocumento], references: [idTipoDocumento], onDelete: Restrict)
  numeroDocumento String?        @map("numero_documento") @db.VarChar(20)
  razonSocial     String?        @map("razon_social") @db.VarChar(255)
  nombreComercial String?        @map("nombre_comercial") @db.VarChar(255)

  departamento       String  @default("Arequipa") @db.VarChar(100)
  provincia          String  @default("Arequipa") @db.VarChar(100)
  distrito           String  @default("Arequipa") @db.VarChar(100)
  direccionComercial String? @map("direccion_comercial") @db.VarChar(255)
  direccionFiscal    String? @map("direccion_fiscal") @db.VarChar(255)
  direccionWeb       String? @map("direccion_web") @db.VarChar(255)
  ubigeo             String  @default("040101") @db.VarChar(6)
  igv                Decimal @default(18.00) @db.Decimal(5, 2)
  telefono           String  @default("-") @db.VarChar(20)
  correo             String? @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sucursal Sucursal @relation(fields: [idSucursal], references: [idSucursal], onDelete: Cascade)

  @@map("sucursales_perfiles")
}

// USUARIOS - SUCURSALES
model UsuarioSucursal {
  idUsuario  Int @map("id_usuario")
  idSucursal Int @map("id_sucursal")

  usuario  Usuario  @relation(fields: [idUsuario], references: [idUsuario], onDelete: Cascade)
  sucursal Sucursal @relation(fields: [idSucursal], references: [idSucursal], onDelete: Cascade)

  @@id([idUsuario, idSucursal])
  @@map("usuarios_sucursales")
}

enum NaturalezaMovimiento {
  ENTRADA
  SALIDA
}

enum TipoAlmacen {
  ALMACEN
  AREA_VENTA
}

model TipoProducto {
  idTipoProducto Int        @id @default(autoincrement()) @map("id_tipo_producto")
  nombre         String     @unique @db.VarChar(100)
  estado         Boolean    @default(true)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  productos      Producto[]

  @@map("tipos_producto")
}

model Categoria {
  idCategoria Int        @id @default(autoincrement()) @map("id_categoria")
  nombre      String     @unique @db.VarChar(100)
  color       String?    @db.VarChar(7)
  estado      Boolean    @default(true)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  productos   Producto[]

  @@map("categorias")
}

model UnidadMedida {
  idUnidadMedida Int        @id @default(autoincrement()) @map("id_unidad_medida")
  nombre         String     @unique @db.VarChar(50)
  simbolo        String     @unique @db.VarChar(10)
  estado         Boolean    @default(true)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  productos      Producto[]

  @@map("unidades_medida")
}

model Producto {
  idProducto     Int                @id @default(autoincrement()) @map("id_producto")
  idTipoProducto Int                @map("id_tipo_producto")
  idCategoria    Int                @map("id_categoria")
  idUnidadMedida Int                @map("id_unidad_medida")
  nombre         String             @db.VarChar(255)
  detalle        String?            @db.VarChar(500)
  codigoBarras   String?            @map("codigo_barras") @db.VarChar(100)
  imagen         String?            @db.VarChar(255)
  estado         Boolean            @default(true)
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  tipoProducto   TipoProducto       @relation(fields: [idTipoProducto], references: [idTipoProducto], onDelete: Restrict)
  categoria      Categoria          @relation(fields: [idCategoria], references: [idCategoria], onDelete: Restrict)
  unidadMedida   UnidadMedida       @relation(fields: [idUnidadMedida], references: [idUnidadMedida], onDelete: Restrict)
  sucursales     ProductoSucursal[]
  referenciasVisuales ReferenciaVisual[]

  @@index([nombre])
  @@map("productos")
}

enum EstadoReferenciaVisual {
  PENDIENTE
  PROCESANDO
  DISPONIBLE
  ERROR
  RETIRADA
}

// MySQL conserva la relación con el catálogo y la cola durable de indexación.
// Los vectores y FAISS pertenecen al servicio Python y se pueden reconstruir.
model ReferenciaVisual {
  idReferencia   Int                    @id @default(autoincrement()) @map("id_referencia")
  idProducto     Int                    @map("id_producto")
  archivo        String                 @db.VarChar(100)
  sha256         String                 @db.Char(64)
  mimeType       String                 @map("mime_type") @db.VarChar(30)
  activo         Boolean                @default(true)
  estado         EstadoReferenciaVisual @default(PENDIENTE)
  modeloVersion  String?                @map("modelo_version") @db.VarChar(255)
  dimension      Int?
  intentos       Int                    @default(0)
  ultimoError    String?                @map("ultimo_error") @db.VarChar(500)
  proximoIntento DateTime?              @map("proximo_intento")
  leaseToken     String?                @map("lease_token") @db.VarChar(36)
  bloqueadoHasta DateTime?              @map("bloqueado_hasta")
  indexadoAt     DateTime?              @map("indexado_at")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  producto       Producto               @relation(fields: [idProducto], references: [idProducto], onDelete: Restrict)

  @@unique([idProducto, sha256])
  @@index([estado, proximoIntento])
  @@map("referencias_visuales")
}

model ProductoSucursal {
  idProductoSucursal Int               @id @default(autoincrement()) @map("id_producto_sucursal")
  idProducto         Int               @map("id_producto")
  idSucursal         Int               @map("id_sucursal")
  precioCompra       Decimal           @default(0) @map("precio_compra") @db.Decimal(14, 2)
  precioVenta        Decimal           @default(0) @map("precio_venta") @db.Decimal(14, 2)
  estado             Boolean           @default(true)
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  producto           Producto          @relation(fields: [idProducto], references: [idProducto], onDelete: Restrict)
  sucursal           Sucursal          @relation(fields: [idSucursal], references: [idSucursal], onDelete: Restrict)
  inventarios        Inventario[]
  comprasDetalle     CompraDetalle[]
  ingresosProductos  IngresoProducto[]

  @@unique([idProducto, idSucursal])
  @@unique([idProductoSucursal, idSucursal])
  @@map("producto_sucursal")
}

model Almacen {
  idAlmacen         Int               @id @default(autoincrement()) @map("id_almacen")
  idSucursal        Int               @map("id_sucursal")
  nombre            String            @db.VarChar(100)
  tipo              TipoAlmacen       @default(ALMACEN)
  direccion         String?           @db.VarChar(255)
  estado            Boolean           @default(true)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  sucursal          Sucursal          @relation(fields: [idSucursal], references: [idSucursal], onDelete: Restrict)
  inventarios       Inventario[]
  compras           Compra[]
  ingresosProductos IngresoProducto[]

  @@unique([idSucursal, nombre])
  @@unique([idAlmacen, idSucursal])
  @@map("almacenes")
}

model Inventario {
  idInventario       Int                    @id @default(autoincrement()) @map("id_inventario")
  idProductoSucursal Int                    @map("id_producto_sucursal")
  idAlmacen          Int                    @map("id_almacen")
  // Clave compartida para impedir relaciones entre sucursales diferentes en MySQL.
  idSucursal         Int                    @map("id_sucursal")
  stock              Decimal                @default(0) @db.Decimal(14, 3)
  stockMinimo        Decimal                @default(0) @map("stock_minimo") @db.Decimal(14, 3)
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")
  productoSucursal   ProductoSucursal       @relation(fields: [idProductoSucursal, idSucursal], references: [idProductoSucursal, idSucursal], onDelete: Restrict, onUpdate: Restrict)
  almacen            Almacen                @relation(fields: [idAlmacen, idSucursal], references: [idAlmacen, idSucursal], onDelete: Restrict, onUpdate: Restrict)
  movimientos        InventarioMovimiento[]

  @@unique([idProductoSucursal, idAlmacen])
  @@index([idSucursal])
  @@map("inventarios")
}

model TipoMovimientoInventario {
  idTipoMovimiento Int                    @id @map("id_tipo_movimiento")
  nombre           String                 @unique @db.VarChar(100)
  entradaSalida    NaturalezaMovimiento   @map("entrada_salida")
  movimientos      InventarioMovimiento[]

  @@map("tipos_movimiento_inventario")
}

model InventarioMovimiento {
  idMovimiento      Int                      @id @default(autoincrement()) @map("id_movimiento")
  idInventario      Int                      @map("id_inventario")
  idTipoMovimiento  Int                      @map("id_tipo_movimiento")
  idUsuario         Int                      @map("id_usuario")
  idCompraDetalle   Int?                     @map("id_compra_detalle")
  idIngresoProducto Int?                     @map("id_ingreso_producto")
  cantidad          Decimal                  @db.Decimal(14, 3)
  stockAnterior     Decimal                  @map("stock_anterior") @db.Decimal(14, 3)
  stockResultante   Decimal                  @map("stock_resultante") @db.Decimal(14, 3)
  observacion       String?                  @db.VarChar(500)
  fechaMovimiento   DateTime                 @default(now()) @map("fecha_movimiento")
  createdAt         DateTime                 @default(now()) @map("created_at")
  inventario        Inventario               @relation(fields: [idInventario], references: [idInventario], onDelete: Restrict)
  tipoMovimiento    TipoMovimientoInventario @relation(fields: [idTipoMovimiento], references: [idTipoMovimiento], onDelete: Restrict)
  usuario           Usuario                  @relation(fields: [idUsuario], references: [idUsuario], onDelete: Restrict)
  compraDetalle     CompraDetalle?           @relation(fields: [idCompraDetalle], references: [idCompraDetalle], onDelete: Restrict)
  ingresoProducto   IngresoProducto?         @relation(fields: [idIngresoProducto], references: [idIngresoProducto], onDelete: Restrict)

  @@index([idInventario, fechaMovimiento])
  @@map("inventario_movimientos")
}

// COMPRAS: el destino se elige una sola vez para toda la compra.
model Compra {
  idCompra        Int      @id @default(autoincrement()) @map("id_compra")
  idProveedor     Int?     @map("id_proveedor")
  nombreProveedor String   @map("nombre_proveedor") @db.VarChar(255)
  idSucursal      Int      @map("id_sucursal")
  idAlmacen       Int      @map("id_almacen")
  idUsuario       Int      @map("id_usuario")
  fechaCompra     DateTime @default(now()) @map("fecha_compra")
  subtotal        Decimal? @db.Decimal(14, 2)
  igv             Decimal? @db.Decimal(14, 2)
  total           Decimal  @db.Decimal(14, 2)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  proveedor    Proveedor?         @relation(fields: [idProveedor], references: [idProveedor], onDelete: Restrict)
  sucursal     Sucursal           @relation(fields: [idSucursal], references: [idSucursal], onDelete: Restrict)
  almacen      Almacen            @relation(fields: [idAlmacen, idSucursal], references: [idAlmacen, idSucursal], onDelete: Restrict, onUpdate: Restrict)
  usuario      Usuario            @relation(fields: [idUsuario], references: [idUsuario], onDelete: Restrict)
  detalles     CompraDetalle[]
  comprobante  Comprobante?
  egresos      Egreso[]
  percepciones CompraPercepcion[]

  @@unique([idCompra, idSucursal])
  @@index([idSucursal, fechaCompra])
  @@map("compras")
}

model CompraDetalle {
  idCompraDetalle    Int      @id @default(autoincrement()) @map("id_compra_detalle")
  idCompra           Int      @map("id_compra")
  idProductoSucursal Int      @map("id_producto_sucursal")
  cantidad           Decimal  @db.Decimal(14, 3)
  // Precio final de la unidad; el desglose de IGV está en la cabecera.
  precioUnitario     Decimal  @map("precio_unitario") @db.Decimal(14, 4)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  compra           Compra                 @relation(fields: [idCompra], references: [idCompra], onDelete: Restrict)
  productoSucursal ProductoSucursal       @relation(fields: [idProductoSucursal], references: [idProductoSucursal], onDelete: Restrict)
  movimientos      InventarioMovimiento[]

  @@index([idCompra])
  @@map("compras_detalle")
}

model TipoComprobante {
  idTipoComprobante Int     @id @default(autoincrement()) @map("id_tipo_comprobante")
  nombre            String  @unique @db.VarChar(100)
  // Es opcional para documentos internos, como una nota de pedido.
  codigoSunat       String? @unique @map("codigo_sunat") @db.VarChar(2)

  comprobantes Comprobante[]

  @@map("tipos_comprobante")
}

// Documentos recibidos por compras; no se duplican los importes de Compra.
model Comprobante {
  idComprobante     Int      @id @default(autoincrement()) @map("id_comprobante")
  idCompra          Int      @unique @map("id_compra")
  idTipoComprobante Int      @map("id_tipo_comprobante")
  serie             String?  @db.VarChar(20)
  numero            String?  @db.VarChar(40)
  fechaEmision      DateTime @map("fecha_emision") @db.Date

  compra          Compra          @relation(fields: [idCompra], references: [idCompra], onDelete: Restrict)
  tipoComprobante TipoComprobante @relation(fields: [idTipoComprobante], references: [idTipoComprobante], onDelete: Restrict)

  @@map("comprobantes")
}

model CompraPercepcion {
  idPercepcion     Int      @id @default(autoincrement()) @map("id_percepcion")
  idCompra         Int      @map("id_compra")
  idEgreso         Int      @map("id_egreso")
  fechaPercepcion  DateTime @map("fecha_percepcion") @db.Date
  baseCalculo      Decimal  @map("base_calculo") @db.Decimal(14, 2)
  porcentaje       Decimal  @db.Decimal(6, 3)
  monto            Decimal  @db.Decimal(14, 2)
  numeroConstancia String?  @map("numero_constancia") @db.VarChar(80)

  compra Compra @relation(fields: [idCompra], references: [idCompra], onDelete: Restrict)
  // El egreso debe pertenecer a la misma compra que la percepción.
  egreso Egreso @relation(fields: [idEgreso, idCompra], references: [idEgreso, idCompra], onDelete: Restrict, onUpdate: Restrict)

  @@unique([idCompra, idEgreso])
  @@map("compras_percepciones")
}

// Solo los ingresos por venta de mercadería llevan productos.
model IngresoProducto {
  idIngresoProducto  Int      @id @default(autoincrement()) @map("id_ingreso_producto")
  idIngreso          Int      @map("id_ingreso")
  idProductoSucursal Int      @map("id_producto_sucursal")
  idAlmacen          Int      @map("id_almacen")
  cantidad           Decimal  @db.Decimal(14, 3)
  precioUnitario     Decimal  @map("precio_unitario") @db.Decimal(14, 4)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  ingreso          Ingreso                @relation(fields: [idIngreso], references: [idIngreso], onDelete: Restrict)
  productoSucursal ProductoSucursal       @relation(fields: [idProductoSucursal], references: [idProductoSucursal], onDelete: Restrict)
  almacen          Almacen                @relation(fields: [idAlmacen], references: [idAlmacen], onDelete: Restrict)
  movimientos      InventarioMovimiento[]

  @@index([idIngreso])
  @@map("ingresos_productos")
}

model DeudaCliente {
  idDeudaCliente   Int       @id @default(autoincrement()) @map("id_deuda_cliente")
  idCliente        Int       @map("id_cliente")
  idIngresoOrigen  Int       @unique @map("id_ingreso_origen")
  idEgreso         Int       @unique @map("id_egreso")
  fechaVencimiento DateTime? @map("fecha_vencimiento") @db.Date
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  cliente       Cliente             @relation(fields: [idCliente], references: [idCliente], onDelete: Restrict)
  ingresoOrigen Ingreso             @relation("IngresoOrigenDeuda", fields: [idIngresoOrigen], references: [idIngreso], onDelete: Restrict)
  egreso        Egreso              @relation(fields: [idEgreso], references: [idEgreso], onDelete: Restrict)
  abonos        AbonoDeudaCliente[]

  @@index([idCliente])
  @@map("deudas_clientes")
}

model AbonoDeudaCliente {
  idDeudaCliente Int @map("id_deuda_cliente")
  idIngresoAbono Int @unique @map("id_ingreso_abono")

  deudaCliente DeudaCliente @relation(fields: [idDeudaCliente], references: [idDeudaCliente], onDelete: Restrict)
  ingresoAbono Ingreso      @relation(fields: [idIngresoAbono], references: [idIngreso], onDelete: Restrict)

  @@id([idDeudaCliente, idIngresoAbono])
  @@map("abonos_deuda_cliente")
}

// Catálogo de configuraciones compartido por todas las sucursales.
model ConfiguracionGlobal {
  nombre    String   @id @db.VarChar(100)
  activo    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("configuraciones_globales")
}
