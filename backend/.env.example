# ================== SERVIDOR ==================
# Puerto HTTP donde NestJS publica la API.
PORT=3000
# ================== BASE DE DATOS ==================
# Cadena de conexión: mysql://usuario:contrasena@host:puerto/base_de_datos
DATABASE_URL="mysql://usuario:contrasena@localhost:3306/innova_store"
# Permite que el cliente MariaDB solicite al servidor su clave pública RSA.
# MySQL puede usar esa clave para cifrar la contraseña durante la autenticación
# cuando no existe una conexión TLS. No envía la contraseña como texto plano.
#
# Desarrollo local: puede mantenerse en "true" para evitar el error
# "RSA public key is not available client side".
# Producción: se recomienda usar TLS/SSL o una clave pública fijada y cambiar
# este valor a "false" para impedir aceptar una clave obtenida dinámicamente.
DB_ALLOW_PUBLIC_KEY_RETRIEVAL="true"

# ===================== AUTENTICACIÓN =====================
# Secreto utilizado para firmar y verificar los tokens JWT.
# Debe ser largo, aleatorio, privado y diferente en cada entorno.
JWT_SECRET="reemplazar-por-un-secreto-aleatorio-largo"


# ================== USUARIOS INICIALES ==================

# Credenciales del superadministrador inicial, con acceso global al sistema.
SUPERADMIN_CORREO="admin@ejemplo.com"
SUPERADMIN_CONTRASENA="reemplazar-por-una-contrasena-segura"

# Credenciales del administrador inicial asociado a una sucursal.
ADMIN_CORREO="admin-sucursal@ejemplo.com"
ADMIN_CONTRASENA="reemplazar-por-otra-contrasena-segura"

# ========== CONSULTA DE DOCUMENTOS - DECOLECTA ==========

# URL base de la API usada para consultar DNI y RUC.
DECOLECTA_URL="https://api.decolecta.com/v1"

# Token privado entregado por Decolecta para autorizar las consultas.
DECOLECTA_TOKEN="colocar-token-de-decolecta"

#  ======== MONITOREO - NESTJS OBSERVE (OPCIONAL) ======== 
# Credenciales para enviar métricas y errores a Observe.
# Si APP_KEY o APP_SECRET están vacíos, el monitoreo queda desactivado y el
# backend funciona normalmente sin intentar autenticarse con ese servicio.
OBSERVE_APP_KEY=""
OBSERVE_APP_SECRET=""

# Nombre con el que este proceso se identifica dentro de Observe.
OBSERVE_SERVICE_ID="backend"

# ========== PRUEBAS DE INTEGRACIÓN (OPCIONAL) ========== 
# Ejecuta las pruebas de logística que consultan una base de datos real.
# Déjalo en "0" durante las pruebas unitarias normales; usa "1" únicamente
# cuando DATABASE_URL apunte a una base de datos de pruebas preparada para ello.
LOGISTICA_DB_TESTS="0"
